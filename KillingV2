KillingTab:AddSwitch("Block All Frames", function(state)
    _G.HardBlockUI = state
    local function applyBlock(obj)
        for _, name in ipairs(blockedFrames) do
            if obj.Name == name then
                if obj:IsA("GuiObject") then obj.Visible = false
                elseif obj:IsA("BillboardGui") then obj.Enabled = false end
                if state and not uiConnections[obj] then
                    uiConnections[obj] = obj.Changed:Connect(function()
                        if _G.HardBlockUI then
                            if obj:IsA("GuiObject") then obj.Visible = false
                            elseif obj:IsA("BillboardGui") then obj.Enabled = false end
                        end
                    end)
                end
            end
        end
    end
    if state then
        for _, v in pairs(localPlayer.PlayerGui:GetDescendants()) do applyBlock(v) end
        _G.UIMonitor = localPlayer.PlayerGui.DescendantAdded:Connect(applyBlock)
    else
        if _G.UIMonitor then _G.UIMonitor:Disconnect() end
        for obj, conn in pairs(uiConnections) do
            conn:Disconnect()
            if obj:IsA("GuiObject") then obj.Visible = true
            elseif obj:IsA("BillboardGui") then obj.Enabled = true end
        end
        uiConnections = {}
    end
end)

